# Application
APP_NAME=FlyRank Capstone Widget Platform
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/flyrank

# Authentication
JWT_SECRET_KEY=change-this-in-local-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:8000,http://localhost:5500

# Geo providers
GEO_PROVIDER_A_URL=
GEO_PROVIDER_A_API_KEY=

GEO_PROVIDER_B_URL=
GEO_PROVIDER_B_API_KEY=

# Side effects
WEBHOOK_URL=